<!DOCTYPE html>
<html lang="am" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ASH-X-B | P2P Crypto & ETB Exchange</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        body { background-color: #0b0e14; color: #e2e8f0; font-family: 'Inter', sans-serif; }
        .glass-card { background: #131722; border: 1px solid #1e2536; }
        .btn-buy { background: #10b981; color: #052e16; font-weight: 700; }
        .btn-buy:hover { background: #059669; }
        .btn-sell { background: #ef4444; color: #fff; font-weight: 700; }
        .btn-sell:hover { background: #dc2626; }
    </style>
</head>
<body class="min-h-screen flex flex-col">
    <!-- Top Navigation -->
    <nav class="glass-card border-b border-gray-800 px-6 py-4 flex justify-between items-center sticky top-0 z-50">
        <div class="flex items-center space-x-3">
            <span class="text-xl font-bold tracking-wider text-white">ASH-X-B <span class="text-xs bg-emerald-500/20 text-emerald-400 px-2 py-0.5 rounded">P2P</span></span>
        </div>
        <div class="hidden md:flex space-x-6 text-sm font-medium text-gray-400">
            <a href="#" class="text-emerald-400">P2P Market</a>
            <a href="#orders" class="hover:text-white transition">My Orders</a>
            <a href="#wallet" class="hover:text-white transition">Wallet</a>
        </div>
        <div class="flex items-center space-x-3">
            <span id="user-status" class="text-xs text-emerald-400">Connected</span>
        </div>
    </nav>

    <!-- Main Dashboard Container -->
    <main class="max-w-7xl w-full mx-auto px-4 sm:px-6 py-8 flex-grow space-y-6">
        <!-- Top Summary Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="glass-card p-5 rounded-xl">
                <div class="flex justify-between items-center text-gray-400 text-sm">
                    <span>Available Balance</span>
                    <i class="fa-solid fa-wallet text-emerald-400"></i>
                </div>
                <div class="mt-2 flex items-baseline space-x-2">
                    <span id="avail-balance" class="text-2xl font-bold text-white">0.00</span>
                    <span class="text-xs text-emerald-400 font-semibold">USDT</span>
                </div>
            </div>
            <div class="glass-card p-5 rounded-xl">
                <div class="flex justify-between items-center text-gray-400 text-sm">
                    <span>In Escrow (Frozen)</span>
                    <i class="fa-solid fa-shield-halved text-amber-400"></i>
                </div>
                <div class="mt-2 flex items-baseline space-x-2">
                    <span id="escrow-balance" class="text-2xl font-bold text-amber-400">0.00</span>
                    <span class="text-xs text-gray-400 font-semibold">USDT</span>
                </div>
            </div>
            <div class="glass-card p-5 rounded-xl">
                <div class="flex justify-between items-center text-gray-400 text-sm">
                    <span>Market Reference Rate</span>
                    <span class="text-xs bg-emerald-500/10 text-emerald-400 px-2 py-0.5 rounded">LIVE</span>
                </div>
                <div class="mt-2 flex items-baseline space-x-2">
                    <span id="live-rate" class="text-2xl font-bold text-white">134.50</span>
                    <span class="text-xs text-gray-400 font-semibold">ETB / USDT</span>
                </div>
            </div>
        </div>

        <!-- P2P Trading Controls & Filter Bar -->
        <div class="glass-card p-4 rounded-xl flex flex-col md:flex-row justify-between items-center gap-4">
            <div class="flex bg-gray-900 p-1 rounded-lg w-full md:w-auto">
                <button id="tab-buy" onclick="switchTab('SELL')" class="flex-1 md:w-32 py-2 rounded-md text-sm font-bold bg-emerald-500 text-gray-950 transition">Buy USDT</button>
                <button id="tab-sell" onclick="switchTab('BUY')" class="flex-1 md:w-32 py-2 rounded-md text-sm font-bold text-gray-400 hover:text-white transition">Sell USDT</button>
            </div>
            <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
                <select id="filter-payment" onchange="renderAds()" class="bg-gray-900 border border-gray-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500">
                    <option value="ALL">All Payment Methods</option>
                    <option value="Telebirr">Telebirr</option>
                    <option value="CBE">Commercial Bank (CBE)</option>
                    <option value="M-Pesa">M-Pesa</option>
                </select>
            </div>
        </div>

        <!-- P2P Order Book Table -->
        <div class="glass-card rounded-xl overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-gray-800 text-xs uppercase text-gray-400 bg-gray-900/50">
                            <th class="py-4 px-6">Advertiser</th>
                            <th class="py-4 px-6">Price (ETB)</th>
                            <th class="py-4 px-6">Available / Limit</th>
                            <th class="py-4 px-6">Payment Method</th>
                            <th class="py-4 px-6 text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody id="ads-table-body" class="divide-y divide-gray-800 text-sm">
                        <tr><td colspan="5" class="py-6 text-center text-gray-500">Loading market ads...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <script>
        const SUPABASE_URL = 'https://yvtnrohneqozpbtlxmrm.supabase.co';
        const SUPABASE_ANON_KEY = 'sb_publishable_zq_XIXe-p0pr0rINsP3ZHw_fTyBszG8';
        
        let _supabase = null;
        try {
            if (window.supabase && window.supabase.createClient) {
                _supabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
            }
        } catch (e) {
            console.error('Supabase init error:', e);
        }

        let currentSide = 'SELL';
        let marketAds = [
            { id: '1', merchant: 'Ash_Trader_ET', side: 'SELL', price: 134.80, avail: 1250.00, payment: 'Telebirr' },
            { id: '2', merchant: 'Abyssinia_FX', side: 'SELL', price: 135.10, avail: 3400.00, payment: 'CBE' },
            { id: '3', merchant: 'Sniper_Crypto', side: 'SELL', price: 135.50, avail: 620.00, payment: 'M-Pesa' }
        ];

        async function fetchAds() {
            if (!_supabase) {
                renderAds();
                return;
            }
            try {
                const { data, error } = await _supabase.from('p2p_ads').select('*').eq('is_active', true);
                if (!error && data && data.length > 0) {
                    marketAds = data.map(ad => ({
                        id: ad.id,
                        merchant: 'Merchant_' + (ad.merchant_id ? ad.merchant_id.substring(0, 5) : 'User'),
                        side: ad.ad_type,
                        price: ad.price_etb,
                        avail: ad.available_amount,
                        payment: ad.payment_method
                    }));
                }
            } catch (err) {
                console.error('Fetch error:', err);
            }
            renderAds();
        }

        function switchTab(side) {
            currentSide = side;
            renderAds();
        }

        function renderAds() {
            const tbody = document.getElementById('ads-table-body');
            const paymentFilter = document.getElementById('filter-payment').value;
            const filtered = marketAds.filter(ad => ad.side === currentSide && (paymentFilter === 'ALL' || ad.payment === paymentFilter));
            
            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" class="py-6 text-center text-gray-500">No active ads found.</td></tr>`;
                return;
            }

            tbody.innerHTML = filtered.map(ad => `
                <tr class="hover:bg-gray-900/40 transition">
                    <td class="py-4 px-6 font-bold text-white">${ad.merchant}</td>
                    <td class="py-4 px-6 font-bold text-white">${Number(ad.price).toFixed(2)} ETB</td>
                    <td class="py-4 px-6">${Number(ad.avail).toFixed(2)} USDT</td>
                    <td class="py-4 px-6 text-amber-400">${ad.payment}</td>
                    <td class="py-4 px-6 text-right">
                        <button class="px-5 py-2 rounded-lg text-xs uppercase tracking-wider ${currentSide === 'SELL' ? 'btn-buy' : 'btn-sell'}">Trade</button>
                    </td>
                </tr>
            `).join('');
        }

        // Initialize display immediately and fetch from DB
        renderAds();
        fetchAds();
    </script>
</body>
</html>
